{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UI Studio",
  "version": "0.1.0",
  "identifier": "com.rocket.uistudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "UI Studio", "width": 1200, "height": 720, "minWidth": 800, "minHeight": 520, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
